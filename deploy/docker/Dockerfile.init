# syntax=docker/dockerfile:1
FROM eclipse-mosquitto:2.0.22@sha256:81a6193ae693942a3231cd3ac52875b02b7e3a19da671b2fb4b55cc874c5b279
USER 0:0
RUN apk add --no-cache python3 openssl
WORKDIR /opt/nexus
ENV PYTHONDONTWRITEBYTECODE=1
COPY tools/init_docker.py tools/init_local.py tools/broker_policy.py tools/
COPY deploy/docker/compose.1panel.yml deploy/docker/compose.1panel.yml
# The one-shot initializer writes only the explicitly mounted private parent.
# It needs neither host Python/source nor Docker or its socket inside the image.
ENTRYPOINT ["python3", "/opt/nexus/tools/init_docker.py", "--native-password-tool"]
